* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
  background: #111827;
  font-family: Arial, sans-serif;
  padding: 20px;
  transition: 0.3s;
}

.calculator {
  width: 100%;
  max-width: 430px;
  background: #1f2937;
  padding: 20px;
  border-radius: 24px;
  box-shadow: 0 10px 30px rgba(0,0,0,0.4);
}

.top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

h1 {
  color: white;
  font-size: 22px;
  margin-bottom: 20px;
}

.top button {
  background: #374151;
  border: none;
  border-radius: 8px;
  padding: 10px;
  cursor: pointer;
}

.display {
  background: #111827;
  padding: 15px;
  border-radius: 12px;
  margin-bottom: 15px;
}

#history {
  color: #9ca3af;
  text-align: right;
  min-height: 20px;
  font-size: 14px;
}

#display {
  width: 100%;
  background: transparent;
  border: none;
  outline: none;
  color: white;
  text-align: right;
  font-size: 32px;
  margin-top: 8px;
}

.mode-row,
.memory {
  display: flex;
  gap: 8px;
  margin-bottom: 10px;
}

.mode-row button,
.memory button {
  flex: 1;
  padding: 10px 5px;
  border: none;
  border-radius: 8px;
  background: #374151;
  color: white;
  cursor: pointer;
  font-size: 12px;
}

.memory button {
  background: #4b5563;
}

.buttons {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 8px;
}

button {
  border: none;
  border-radius: 10px;
  padding: 15px 5px;
  font-size: 16px;
  background: #374151;
  color: white;
  cursor: pointer;
  transition: 0.15s;
}

button:hover {
  background: #4b5563;
}

button:active {
  transform: scale(0.94);
}

.function {
  background: #374151;
  color: #93c5fd;
  font-size: 14px;
}

.operator {
  background: #2563eb;
  font-size: 20px;
}

.equals {
  background: #16a34a;
  font-size: 22px;
}

.clear {
  background: #dc2626;
}

.delete {
  background: #b45309;
}

.zero {
  grid-column: span 2;
}

.history-box {
  margin-top: 20px;
  background: #111827;
  padding: 15px;
  border-radius: 12px;
}

.history-box h2 {
  color: white;
  font-size: 16px;
  margin-top: 0;
}

#historyList {
  color: #d1d5db;
  font-size: 14px;
  max-height: 150px;
  overflow-y: auto;
}

.history-item {
  padding: 8px 0;
  border-bottom: 1px solid #374151;
}

.light {
  background: #e5e7eb;
}

.light .calculator {
  background: #ffffff;
}

.light h1 {
  color: #111827;
}

.light .display,
.light .history-box {
  background: #f3f4f6;
}

.light #display {
  color: #111827;
}

.light .top button,
.light .mode-row button,
.light .memory button,
.light button {
  color: #111827;
  background: #e5e7eb;
}

.light .operator {
  background: #93c5fd;
}

.light .equals {
  background: #86efac;
}

.light .clear {
  background: #fca5a5;
}

.light .delete {
  background: #fdba74;
}

@media (max-width: 380px) {
  .calculator {
    padding: 12px;
  }

  button {
    padding: 13px 3px;
    font-size: 14px;
  }

  #display {
    font-size: 26px;
  }
}
